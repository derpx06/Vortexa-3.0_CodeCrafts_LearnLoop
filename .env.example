# =============================================================================
# LearnLoop AI environment variables
# Copy this file to .env.local and fill in the provider values you need.
# Never commit .env.local, service.json, or other files containing credentials.
# =============================================================================

# Required for local development. Run `pnpm db:up` first.
DATABASE_URL=postgres://openmaic:openmaic-dev@127.0.0.1:5432/openmaic

# Model configuration. The checked-in template is openmaic.example.yml.
OPENMAIC_CONFIG=openmaic.yml

# Configure at least one provider, or add credentials in the app settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Vertex AI OAuth/ADC alternative. Keep the credential file server-side.
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_CREDENTIALS_FILE=service.json

# Optional site protection for shared/network deployments.
ACCESS_CODE=

# Compulsory sign-in: the application forces every visitor to log in, so the
# middleware never needs an anonymous owner cookie. Keep this false so the
# middleware stops minting one on page requests.
OWNER_ANONYMOUS_PREMINT=false

# Optional local development database port when 5432 is occupied.
OPENMAIC_DB_PORT=5432

# Optional server settings.
OPENMAIC_PORT=3000
OPENMAIC_PUBLISH_ADDRESS=127.0.0.1
OPENMAIC_SECRET_KEY=
